# Copy to .env and replace both required secrets. Never commit .env.

# Required: application startup fails when either value is blank or both are equal.
EAFC_VIEWER_PASSWORD=replace-with-a-long-viewer-password
EAFC_ADMIN_PASSWORD=replace-with-a-different-long-admin-password

# Optional security settings.
# Use true when the application is served through HTTPS; local HTTP requires false.
EAFC_COOKIE_SECURE=false
EAFC_SESSION_TIMEOUT=8h

# Discord delivery (optional at boot; required before Discord publication)
EAFC_DISCORD_MATCH_WEBHOOK_URL=
# Required when EAFC_POSTGRES_MIRROR_ENABLED=true. Generate a Base64-encoded 32-byte key;
# it encrypts durable per-club webhook URLs and must remain stable across deploys.
EAFC_DISCORD_SECRET_ENCRYPTION_KEY=

# Acquisition control (set to false to disable EA polling and Discord delivery)
EAFC_ACQUISITION_ENABLED=true

# PostgreSQL mirror (set to true to enable parallel persistence)
EAFC_POSTGRES_MIRROR_ENABLED=false
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/eafc_stats
SPRING_DATASOURCE_USERNAME=eafc_collector
SPRING_DATASOURCE_PASSWORD=replace-with-database-password

# PostgreSQL periodic sync (requires mirror-enabled=true)
EAFC_POSTGRES_SYNC_ENABLED=false
EAFC_POSTGRES_SYNC_INTERVAL_MS=300000

# Internal EA Gateway. The token is required whenever acquisition is enabled.
EA_GATEWAY_BASE_URL=http://127.0.0.1:8081
EA_GATEWAY_INTERNAL_TOKEN=replace-with-a-long-random-secret
ADMIN_INTERNAL_TOKEN=replace-with-a-different-long-random-secret

# Incremental EA polling: scheduler cycles begin with a small recent window and
# expand only if the canonical acquisition checkpoint is absent.
EAFC_INCREMENTAL_INITIAL_WINDOW=5
EAFC_INCREMENTAL_MAX_WINDOW=20

# Optional deployment/container settings.
APP_WEB_NETWORK_ENABLED=true
EAFC_DASHBOARD_AUTO_OPEN=false

# Optional JVM override. The image default reserves 20% of the container for
# heap and leaves the remaining budget for the Node gateway and native JVM
# memory. Keep this value when deploying the complete service in a 1 GiB cgroup.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=20.0 -XX:+ExitOnOutOfMemoryError
